# Select staging or production for the local AAA, search, DDS, and processing APIs.
EODMS_TARGET_ENV=staging
# NAPL is enabled for staging and disabled for production by default.
# Set true to enable it in a production build for testing.
# VITE_ENABLE_NAPL_EXPERIENCE=true
# NAPL ordering is always routed to staging.
EODMS_STAGING_DOMAIN=xxx

# Used when EODMS_TARGET_ENV=production.
EODMS_PRODUCTION_DOMAIN=https://eodms-sgdot.nrcan-rncan.gc.ca

# Optional: route local AAA requests through an SSM tunnel to the staging host.
# Keep the tunnel open and set the local port used by AWS-StartPortForwardingSession.
# EODMS_AAA_TUNNEL_PORT=5445

VITE_ENABLE_USER_PROFILE=false