# Select staging, production, or proxy for the local AAA, search, DDS, and processing APIs.
EODMS_TARGET_ENV=staging
# NAPL ordering is always routed to staging.
EODMS_STAGING_DOMAIN=xxx

# Used when EODMS_TARGET_ENV=production.
EODMS_PRODUCTION_DOMAIN=https://eodms-sgdot.nrcan-rncan.gc.ca

# Proxy mode sends all four API families through one local port-forwarded endpoint.
# The forwarded endpoint must serve /aaa, /search, /dds, and /processing.
# Set EODMS_TARGET_ENV=proxy and keep the tunnel open while using the app.
# EODMS_PROXY_PORT=5445

VITE_ENABLE_USER_PROFILE=false